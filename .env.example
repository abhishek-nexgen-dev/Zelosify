# =============================================================================
# Zelosify Environment Configuration (.env.example)
# Copy to Zelosify-Backend/Server/.env
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECRET=replace_with_a_unique_local_session_secret

# PostgreSQL Database (Prisma)
# Native local PostgreSQL; set the password for your local postgres role
DATABASE_URL=postgresql://postgres:replace_with_local_db_password@localhost:5432/zelosify?schema=public

# JWT & Token Encryption
# JWT_SECRET: Secret key for signing temporary auth tokens
JWT_SECRET=replace_with_a_unique_local_jwt_secret_at_least_32_characters
# ENCRYPTION_ALGORITHM: AES cipher used for upload token encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
# ENCRYPTION_KEY: 32-byte hexadecimal string (64 hex characters)
ENCRYPTION_KEY=replace_with_64_hex_characters_generated_for_this_environment

# Storage Configuration (Google Cloud Storage Bucket / AWS S3)
STORAGE_PROVIDER=google
# Google Cloud Storage Settings
GCS_BUCKET_NAME=zelosify-recruit-bucket
GCP_PROJECT_ID=zelosify-dev
GOOGLE_APPLICATION_CREDENTIALS=
GCS_SIGNED_URL_EXPIRES_IN=3600
# AWS S3 Settings (Alternative when STORAGE_PROVIDER=aws)
S3_AWS_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_aws_access_key_id
S3_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
S3_BUCKET_NAME=zelosify-recruit-bucket
# S3_ENDPOINT: Optional custom S3 endpoint (for LocalStack, MinIO, or Cloudflare R2)
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_PRESIGNED_URL_EXPIRES_IN: Lifespan of presigned URLs in seconds (default: 3600)
S3_PRESIGNED_URL_EXPIRES_IN=3600
# UPLOAD_TOKEN_EXPIRY_MS: Upload token lifespan in milliseconds (default: 300000 = 5 minutes)
UPLOAD_TOKEN_EXPIRY_MS=300000
# MAX_FILE_SIZE_BYTES: Maximum multipart file size in bytes (default: 100MB)
MAX_FILE_SIZE_BYTES=104857600
# ALLOWED_RESUME_EXTENSIONS: Comma-separated allowed resume extensions
ALLOWED_RESUME_EXTENSIONS=.pdf,.pptx,.ppt

# Keycloak Identity & Access Management
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=Zelosify
KEYCLOAK_CLIENT_ID=dynamic-client
KEYCLOAK_CLIENT_SECRET=replace_with_keycloak_client_secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_a_unique_local_keycloak_admin_password
# KEYCLOAK_RS256_SIG: Realm RS256 public key (without PEM header/footer or with PEM format)
KEYCLOAK_RS256_SIG=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAmockpublickeyforzelosifyrealmdevelopment

# Google Cloud AI Scoring & Recommendation Configuration (Gemini)
AI_PROVIDER=google
GEMINI_API_KEY=replace_with_gemini_api_key
GOOGLE_API_KEY=replace_with_google_api_key
GOOGLE_CLOUD_API_KEY=replace_with_google_cloud_api_key
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=150
AI_TEMPERATURE=0.2

# Alternate LLM Provider (Groq)
GROQ_API_KEY=replace_with_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

# Authentication Cookie Lifespans & Cache
ACCESS_TOKEN_MAX_AGE_MS=14400000
REFRESH_TOKEN_MAX_AGE_MS=86400000
USER_CACHE_TTL_MS=300000

# Single Tenant & Default Admin Auto-Provisioning Configuration
DEFAULT_TENANT_ID=8dc0e05b-2956-4d74-b0e9-5aea5ab3b748
DEFAULT_TENANT_NAME="Bruce Wayne Corp"
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@zelosify.com
DEFAULT_ADMIN_PASSWORD=replace_with_a_unique_local_admin_password
DEFAULT_ADMIN_FIRST_NAME=System
DEFAULT_ADMIN_LAST_NAME=Admin


# Pagination & Defaults
DEFAULT_PAGE_LIMIT=10
MAX_PAGE_LIMIT=100
DEFAULT_TENANT_NAME=Bruce Wayne Corp
DEFAULT_HIRING_MANAGER_NAME=Hiring Team
