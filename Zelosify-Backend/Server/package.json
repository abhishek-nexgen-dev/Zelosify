{
  "name": "backend",
  "version": "1.0.0",
  "description": "Zelosify Recruit Backend Node.js Server",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prestart": "node scripts/wait-for-postgres.mjs && prisma migrate deploy",
    "dev": "nodemon src/index.ts",
    "predev": "node scripts/wait-for-postgres.mjs && prisma migrate deploy",
    "db:wait": "node scripts/wait-for-postgres.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "node scripts/wait-for-postgres.mjs && prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "seed:openings": "tsx src/scripts/seedOpenings.ts",
    "keycloak:install": "bash ../../scripts/install-keycloak.sh",
    "keycloak:start": "bash ../../scripts/start-keycloak.sh",
    "test": "vitest --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@google-cloud/storage": "^9.0.0",
    "@langchain/core": "^1.4.1",
    "@langchain/google": "^0.2.15",
    "@langchain/groq": "^1.3.1",
    "@prisma/client": "^6.19.3",
    "ajv": "^8.20.0",
    "axios": "^1.21.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "keycloak-connect": "^26.1.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "otplib": "^12.0.1",
    "pdf-extraction": "^1.0.2",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ajv": "^0.0.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
